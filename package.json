{
  "name": "embee-nexus-v2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @embee/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json}\"",
    "test": "pnpm -r test",
    "supabase:types": "supabase gen types typescript --local > apps/web/src/lib/db/database.types.ts"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "supabase": "^2.15.8",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "lightningcss",
      "unrs-resolver",
      "workerd"
    ]
  }
}
