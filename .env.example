# =============================================================================
# Embee Nexus V2 — Environment Template
# =============================================================================
# Copy to .env.local for local development. `.env.local` is git-ignored and
# must NEVER be committed.
#
# PUBLIC values are embedded into the browser bundle by Next.js and must
# never carry secrets. SERVER values are validated in lib/env/server.ts,
# are protected by the `server-only` import guard, and must never be passed
# to client code, serialized into props, or logged.
#
# Variable names only — see docs/design/API_CREDENTIAL_INVENTORY.md for the
# full credential inventory and which phase requires each variable.
# =============================================================================

# --- Core (M0) ---------------------------------------------------------------
# PUBLIC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (M0 — active) ----------------------------------------------------
# PUBLIC — project URL and anon (publishable) key. Data access remains
# protected by Row Level Security; the anon key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER — bypasses Row Level Security. Never expose to the client bundle.
# No runtime call sites in M0–M3; reserved for M4 webhooks and background jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SERVER — used for verifying Supabase JWTs in server-side checks.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Maps (M2 — active) --------------------------------------------------------
# SERVER — private API key for geocoding/routing (Stadia adapter). Browser or
# mobile map tiles will use a SEPARATE public token (NEXT_PUBLIC_*) issued by
# the provider when map-display screens are authorized. Never reuse this key.
STADIA_MAPS_API_KEY=your-stadia-api-key

# --- Payments — M4 (do not commit real values) ---------------------------------
# SERVER — payment secret key. Never expose to the client bundle.
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# SERVER — exact webhook secret hash configured in the Flutterwave dashboard.
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash
# PUBLIC — client-side checkout initialization. Add when M4 is authorized.
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# --- Notifications — future (SMS provider: FOUNDER DECISION REQUIRED) ----------
# Variable names below are placeholders; do not provision until the provider
# decision (and D26 SMS cost ownership) is made.
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=
# Push (M7, after mobile client exists): FCM/APNs credentials belong in
# deployment secrets, not this template.

# --- Observability (optional — off by default) ----------------------------------
SENTRY_DSN=
# One of: debug | info | warn | error
LOG_LEVEL=info
