# =============================================================================
# Embee Nexus V2 — Environment Template
# =============================================================================
# Copy to .env.local for local development. `.env.local` is git-ignored and
# must NEVER be committed.
#
# PUBLIC values are embedded into the browser bundle by Next.js and must
# never carry secrets. SERVER values are validated in lib/env/server.ts,
# are protected by the `server-only` import guard, and must never be passed
# to client code, serialized into props, or logged.
# =============================================================================

# --- Application -------------------------------------------------------------
# PUBLIC
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# PUBLIC — project URL and anon (publishable) key. Data access remains
# protected by Row Level Security; the anon key is not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER — bypasses Row Level Security. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SERVER — used for verifying Supabase JWTs in server-side checks.
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Flutterwave (payments — integrated in M4) --------------------------------
# SERVER — payment secret key. Never expose to the client bundle.
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
# SERVER — exact webhook secret hash configured in the Flutterwave dashboard.
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-hash

# --- Stadia Maps (maps — integrated in M2) ------------------------------------
# SERVER — private API key for geocoding/routing. Browser map tiles, if used
# later, will use a separate public token issued by the provider.
STADIA_MAPS_API_KEY=your-stadia-api-key

# --- Observability (optional) --------------------------------------------------
SENTRY_DSN=
# One of: debug | info | warn | error
LOG_LEVEL=info
